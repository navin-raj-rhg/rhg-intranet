# Copy this file to .env and fill in real values. Never commit .env.

# ── Supabase ─────────────────────────────────────────────────────
# Project Settings → API
NUXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NUXT_PUBLIC_SUPABASE_ANON_KEY=
NUXT_SUPABASE_SERVICE_ROLE_KEY=

# Project Settings → Database → Connection string
# Direct connection (port 5432) - used only for running migrations
NUXT_SUPABASE_DB_URL=postgresql://postgres:[PASSWORD]@db.xxxxxxxx.supabase.co:5432/postgres
# Pooled connection, "Transaction" mode (port 6543) - used by the running app
NUXT_SUPABASE_DB_POOL_URL=postgresql://postgres.xxxxxxxx:[PASSWORD]@aws-0-xx-xxxx-1.pooler.supabase.com:6543/postgres

# ── Cloudflare R2 ────────────────────────────────────────────────
# Cloudflare dashboard → R2 → Manage API tokens
NUXT_R2_ACCOUNT_ID=
NUXT_R2_ACCESS_KEY_ID=
NUXT_R2_SECRET_ACCESS_KEY=
NUXT_R2_BUCKET=rhg-intranet

# ── Microsoft 365 SSO (added in a later phase, not needed for the demo) ──
# NUXT_MS_CLIENT_ID=
# NUXT_MS_CLIENT_SECRET=
# NUXT_MS_TENANT_ID=
